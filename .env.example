# AI Configuration
AI_PROVIDER=openrouter
AI_MODEL=qwen/qwen3-coder-32b
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4000

# Optional: Override API endpoint
AI_ENDPOINT=

# Required: Get from https://openrouter.ai/
AI_API_KEY=your-api-key-here

# Application
APP_NAME=AI Coder
APP_VERSION=1.0.0

# Features
ENABLE_TELEMETRY=false
DEBUG_MODE=false