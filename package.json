{
  "name": "crux-desktop",
  "version": "1.0.0",
  "description": "CruX desktop AI IDE",
  "main": "electron/dist/main/index.js",
  "author": "CruX",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:frontend\" \"npm run dev:electron\" \"npm run dev:app\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:electron": "cd electron && npm run dev",
    "dev:app": "wait-on tcp:5173 file:./electron/dist/main/index.js && electron .",
    "build": "npm run build:frontend && npm run build:electron",
    "build:frontend": "cd frontend && npm run build",
    "build:electron": "cd electron && npm run build",
    "package": "npm run build && electron-packager . CruX --platform=win32 --arch=x64 --out=release --overwrite --asar --prune=true",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "electron-log": "^5.0.3",
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "concurrently": "^8.2.2",
    "electron": "^41.3.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "wait-on": "^9.0.5"
  }
}
